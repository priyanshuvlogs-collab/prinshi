# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin ----
# Password for /admin. Required for the admin area to work.
ADMIN_PASSWORD=
# Random string used to sign confirm / unsubscribe / admin tokens. 32+ chars.
APP_SECRET=

# ---- Storage (optional; falls back to a local JSON file in .data/ when unset) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (optional; falls back to logging the email to the server console) ----
# Resend API key for double opt-in and marketing emails.
RESEND_API_KEY=
EMAIL_FROM="Prinshi Trades <drops@example.com>"

# ---- GoHighLevel (optional) ----
# When set, every sign-up is also POSTed as JSON to this inbound webhook.
GHL_WEBHOOK_URL=

# ---- Analytics (optional; loaded only after cookie consent) ----
NEXT_PUBLIC_GA4_ID=
# Meta Pixel. Leave empty unless paid ads are running.
NEXT_PUBLIC_META_PIXEL_ID=
